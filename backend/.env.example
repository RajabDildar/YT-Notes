GOOGLE_API_KEY=MY_GOOGLE_API_KEY

# Google chat model (primary)
GOOGLE_CHAT_MODEL=gemini-3.1-flash-lite
# Fallback if primary fails
GOOGLE_CHAT_MODEL_FALLBACK=gemini-3.5-flash

# Embeddings via Google Gemini API
GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# Retrieval
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Chroma persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./data/chroma

# CORS for Chrome extension
CORS_ORIGINS=chrome-extension://*
