GROQ_API_KEY=your_api-key
HUGGINGFACE_API_KEY=your_api_key(must use fine-grained token with read access)

# Chat model (primary)
GROQ_CHAT_MODEL=deepseek-ai/Deepseek-V4-Pro
# Fallback if primary fails
GROQ_CHAT_MODEL_FALLBACK=llama-3.1-8b-instant

# Embeddings via Hugging Face Inference API
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Chroma persistence directory (relative to backend/)
CHROMA_PERSIST_DIR=./data/chroma

# CORS for Chrome extension
CORS_ORIGINS=chrome-extension://*
